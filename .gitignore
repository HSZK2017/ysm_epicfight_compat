# Gradle / build output
.gradle/
build/
out/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.factorypath

# ForgeGradle dev run directory: generated configs, logs, crashes, saves and
# downloaded/installed mod jars are runtime artifacts, not sources.
# The locally installed maid model pack has no confirmed redistribution grant.
run/tlm_custom_pack/
run/config/
run/crash-reports/
run/defaultconfigs/
run/logs/
run/mods/
run/reports/
run/resourcepacks/
run/saves/
run/screenshots/

# OS / editor noise
Thumbs.db
.DS_Store
*.log

# Test-run output at the project root (ForgeGradle test task)
logs/
*.spring-bak

# Measurement probes (T8/T11/T12) write their tables here during a test run. They are regenerated
# output, not fixtures - the fixtures live in src/test/resources - so they do not belong in a diff.
tmp_verify/

# Locally supplied model fixtures. These may contain third-party ARR artwork and
# must never be committed or included in the CI checkout.
.local-test-fixtures/
src/test/resources/golden/
src/test/resources/cloth/
*.ysm
